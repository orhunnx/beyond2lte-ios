## @file
# Single-CPU plain ARM64 XNU loader for beyond2lte UEFI.
# SPDX-License-Identifier: BSD-2-Clause
##
[Defines]
  INF_VERSION    = 0x0001001B
  BASE_NAME      = XnuLoader
  FILE_GUID      = 92742D9E-1A4F-42F8-9DC9-53895297B2F4
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 0.1
  ENTRY_POINT    = UefiMain

[Sources]
  XnuLoader.c
  XnuHandoff.S
  MachO.c
  DeviceTree.c
  Progress.c
  Arena.c
  BootPayload.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec

[LibraryClasses]
  ArmLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gEfiLoadedImageProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiGraphicsOutputProtocolGuid
  gEfiRngProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiDiskIoProtocolGuid
  gEfiPartitionInfoProtocolGuid

[Guids]
  gEfiFileInfoGuid

[BuildOptions]
  *_*_*_CC_FLAGS = -DB2L_UEFI_BUILD

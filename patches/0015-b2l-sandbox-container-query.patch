+#if defined(ARM64_BOARD_CONFIG_B2L)
+/* iOS 26 operation 0x43: two user pointers to 64-bit output values.
+ * The unconfined development port has no expected sandbox container.
+ * Do not fabricate paths, extension tokens or profile state. */
+static int
+b2l_sandbox_container_expected(user_addr_t arg)
+{
+	struct {
+		user64_addr_t expected;
+		user64_addr_t restricted;
+	} output;
+	uint64_t none = 0;
+	int error = copyin(arg, &output, sizeof(output));
+	if (error) {
+		return error;
+	}
+	if (output.expected) {
+		error = copyout(&none, output.expected, sizeof(none));
+		if (error) {
+			return error;
+		}
+	}
+	if (output.restricted) {
+		error = copyout(&none, output.restricted, sizeof(none));
+	}
+	return error;
+}
+#endif
+
 int

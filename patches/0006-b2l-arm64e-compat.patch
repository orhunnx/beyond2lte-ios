  *
  * Handles page-in requests from VM.
  */
+#if defined(ARM64_BOARD_CONFIG_B2L)
+/* Read one physical VM page from the original vnode-backed object. Never
+ * assume that adjacent file pages have adjacent physical addresses. */
+static kern_return_t
+b2l_shared_region_read_page(vm_object_t object, vm_object_offset_t offset,
+    void *destination, struct vm_object_fault_info *info,
+    unsigned *validated, unsigned *tainted, unsigned *nx)
+{
+    vm_page_t page = VM_PAGE_NULL, top = VM_PAGE_NULL;
+    vm_object_t owner;
+    vm_prot_t prot;
+    kern_return_t error;
+    vm_fault_return_t result;
+    vm_offset_t address;
+    const struct vm_object_fault_info original_info = *info;
+    struct vm_object_fault_info local_info;
+retry:
+    /* vm_fault_page may adjust offsets while traversing shadows. */
+    local_info = original_info;
+    vm_page_grab_prime();
+    vm_object_lock(object);
+    vm_object_paging_begin(object);
+    prot = VM_PROT_READ;
+    error = 0;
+    page = VM_PAGE_NULL;
+    top = VM_PAGE_NULL;
+    result = vm_fault_page(object, offset, VM_PROT_READ, FALSE, FALSE,
+        &prot, &page, &top, NULL, &error, FALSE, &local_info, NULL);
+    switch (result) {
+    case VM_FAULT_SUCCESS:
+        break;
+    case VM_FAULT_RETRY:
+        goto retry;
+    case VM_FAULT_MEMORY_SHORTAGE:
+        if (vm_page_wait(info->interruptible)) goto retry;
+        return MACH_SEND_INTERRUPTED;
+    case VM_FAULT_INTERRUPTED:
+        return MACH_SEND_INTERRUPTED;
+    case VM_FAULT_SUCCESS_NO_VM_PAGE:
+        vm_object_paging_end(object);
+        vm_object_unlock(object);
+        return KERN_MEMORY_ERROR;
+    case VM_FAULT_BUSY:
+        return KERN_ALREADY_WAITING;
+    default:
+        return error ? error : KERN_MEMORY_ERROR;
+    }
+    assert(page != VM_PAGE_NULL);
+    owner = VM_PAGE_OBJECT(page);
+    assert(page->vmp_busy && owner->paging_in_progress > 0);
+    address = (vm_offset_t)phystokv((pmap_paddr_t)
+        VM_PAGE_GET_PHYS_PAGE(page) << PAGE_SHIFT);
+    if (owner->code_signed) {
+        vm_page_validate_cs_mapped(page, PAGE_SIZE, 0, (const void *)address);
+    }
+    *validated = page->vmp_cs_validated;
+    *tainted = page->vmp_cs_tainted;
+    *nx = page->vmp_cs_nx;
+    bcopy((const void *)address, destination, PAGE_SIZE);
+    vm_page_wakeup_done(owner, page);
+    vm_object_paging_end(owner);
+    vm_object_unlock(owner);
+    if (top != VM_PAGE_NULL) {
+        assert(VM_PAGE_OBJECT(top) == object);
+        vm_object_lock(object);
+        VM_PAGE_FREE(top);
+        vm_object_paging_end(object);
+        vm_object_unlock(object);
+    }
+    return KERN_SUCCESS;
+}
+
+/* Validate all original chain links before the upstream slide routine writes
+ * anything. Metadata is file input; an offset must never escape wired scratch. */
+static boolean_t
+b2l_shared_region_chain_valid(uint32_t version, uint16_t start,
+    const uint8_t *page, uint32_t size)
+{
+    uint64_t offset = start;
+    if (version != 3 && version != 5) return FALSE;
+    if (start == 0xffff) return TRUE;
+    for (;;) {
+        uint64_t value, delta;
+        if (size < sizeof(value) || offset > size - sizeof(value)) return FALSE;
+        memcpy(&value, page + offset, sizeof(value));
+        if (version == 3) {
+            if (value & (UINT64_C(1) << 62)) return FALSE;
+            delta = ((value >> 51) & 0x7ff) * sizeof(value);
+        } else {
+            delta = ((value >> 52) & 0x7ff) * sizeof(value);
+        }
+        if (delta == 0) return TRUE;
+        if (delta > size || offset > size - delta) return FALSE;
+        offset += delta;
+    }
+}
+
+/* A 16 KiB slide chain can start in any of its four 4 KiB VM pages. Assemble
+ * the original logical page in wired scratch, rebase there, then publish only
+ * the requested physical page. The backing file and other VM pages stay clean.
+ * This also avoids recursively faulting a source page already held busy. */
+static kern_return_t
+b2l_shared_region_copy_large(shared_region_pager_t pager, vm_object_t object,
+    vm_object_offset_t source_offset, vm_offset_t destination,
+    struct vm_object_fault_info *info, unsigned *validated,
+    unsigned *tainted, unsigned *nx)
+{
+    vm_shared_region_slide_info_t si = pager->srp_slide_info;
+    uint32_t size = si->si_slide_info_entry->page_size;
+    vm_object_offset_t first, relative, end;
+    kern_return_t result = KERN_FAILURE;
+    unsigned good = ~0u, bad = 0, noexec = 0;
+    uint8_t *scratch;
+    if (!b2l_arm64e_compat_enabled() || PAGE_SIZE != 4096 || size != 16384 ||
+        (source_offset & PAGE_MASK) || (si->si_start & PAGE_MASK) ||
+        (si->si_end & PAGE_MASK) || si->si_start > si->si_end) {
+        return KERN_FAILURE;
+    }
+    if (source_offset < si->si_start || source_offset >= si->si_end) {
+        return b2l_shared_region_read_page(object, source_offset,
+            (void *)destination, info, validated, tainted, nx);
+    }
+    relative = source_offset - si->si_start;
+    first = si->si_start + (relative & ~((uint64_t)size - 1));
+    if (first > UINT64_MAX - size || (end = first + size) > si->si_end ||
+        ((first - si->si_start) / size) > UINT32_MAX) {
+        return KERN_FAILURE;
+    }
+    scratch = kalloc_data(size, Z_WAITOK);
+    if (scratch == NULL) return KERN_RESOURCE_SHORTAGE;
+    for (uint32_t part = 0; part < size; part += PAGE_SIZE) {
+        unsigned v = 0, t = 0, n = 0;
+        result = b2l_shared_region_read_page(object, first + part,
+            scratch + part, info, &v, &t, &n);
+        if (result != KERN_SUCCESS) goto done;
+        /* All chain input pages influence the result. Propagate any taint. */
+        good &= v;
+        bad |= t;
+        if (first + part == source_offset) noexec = n;
+    }
+    uint32_t index = (uint32_t)((first - si->si_start) / size);
+    uint32_t version = si->si_slide_info_entry->version;
+    uint16_t start;
+    if (version == 3) {
+        if (index >= si->si_slide_info_entry->v3.page_starts_count) {
+            result = KERN_FAILURE;
+            goto done;
+        }
+        start = si->si_slide_info_entry->v3.page_starts[index];
+    } else if (version == 5) {
+        if (index >= si->si_slide_info_entry->v5.page_starts_count) {
+            result = KERN_FAILURE;
+            goto done;
+        }
+        start = si->si_slide_info_entry->v5.page_starts[index];
+    } else {
+        result = KERN_FAILURE;
+        goto done;
+    }
+    if (!b2l_shared_region_chain_valid(version, start, scratch, size)) {
+        result = KERN_FAILURE;
+        goto done;
+    }
+    result = vm_shared_region_slide_page(si, (vm_offset_t)scratch,
+        si->si_slid_address + first - si->si_start,
+        (uint32_t)((first - si->si_start) / size), 0);
+    if (result == KERN_SUCCESS) {
+        bcopy(scratch + source_offset - first, (void *)destination, PAGE_SIZE);
+        *validated = good;
+        *tainted = bad;
+        *nx = noexec;
+    }
+done:
+    kfree_data(scratch, size);
+    return result;
+}

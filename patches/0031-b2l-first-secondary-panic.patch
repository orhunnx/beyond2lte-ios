+#if defined(B2L)
+/* Per-CPU diagnostic record, with no allocation, mutex or thread dependency. */
+void b2l_smp_checkpoint(unsigned stage, uintptr_t arg)
+{
+    unsigned cpu = (unsigned)(__builtin_arm_rsr64("MPIDR_EL1") & 0xffff);
+    if (!cpu || cpu >= 6) return;
+    extern uint64_t b2l_smp_mailbox[6][16];
+    uint64_t *m = b2l_smp_mailbox[cpu];
+    uintptr_t sp; __asm__ volatile("mov %0, sp" : "=r"(sp));
+    m[1] = (uintptr_t)__builtin_return_address(0); m[2] = arg; m[3] = sp;
+    __atomic_store_n(&m[0], stage, __ATOMIC_RELEASE);
+    CleanPoC_DcacheRegion((vm_offset_t)m, 128);
+    __builtin_arm_dsb(DSB_SY);
+}
+void b2l_smp_dump(void)
+{
+    extern uint64_t b2l_smp_mailbox[6][16];
+    extern void b2l_early_trace(const char *, ...);
+    for (unsigned cpu = 1; cpu < 6; ++cpu) {
+        uint64_t stage = b2l_smp_progress(cpu);
+        if (!stage) continue;
+        volatile uint64_t *m = b2l_smp_mailbox[cpu];
+        b2l_early_trace("B2L FIRST: cpu=%u stage=%llu lr=0x%llx\n arg=0x%llx sp=0x%llx\n",
+            cpu, stage, m[1], m[2], m[3]);
+    }
+}
+#endif

+#if defined(B2L) && CONFIG_SCHED_EDGE
+/* No Apple CLPC provider exists on this board. Seed native Edge preferences
+ * by QoS, keeping binding, priority inheritance, runqueues and spill logic.
+ * P=Samsung M4, M=Cortex-A75, E=Cortex-A55. Kernel work prefers A75 so the
+ * four cache workers do not compete with user-interactive work on M4. */
+static pset_id_t
+b2l_sched_initial_preferred_pset(sched_bucket_t bucket, bool kernel_group)
+{
+    pset_type_t desired = bucket == TH_BUCKET_SHARE_BG ? PSET_AMP_E :
+        (kernel_group || bucket == TH_BUCKET_SHARE_UT) ? PSET_AMP_M : PSET_AMP_P;
+    for (pset_id_t i = 0; i < sched_num_psets; ++i) {
+        if (pset_array[i] && pset_array[i]->pset_type == desired) return i;
+    }
+    /* Restricted CPU configurations must not invent a nonexistent pset. */
+    return sched_boot_pset->pset_id;
+}
+#endif

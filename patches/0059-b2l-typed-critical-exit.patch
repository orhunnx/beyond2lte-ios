diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1983,6 +1983,13 @@
 
 	char *exit_reason_desc = exit_reason_get_string_desc(p->p_exit_reason);
 
+#if defined(ARM64_BOARD_CONFIG_B2L)

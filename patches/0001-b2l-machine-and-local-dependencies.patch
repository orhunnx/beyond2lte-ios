 	__builtin_unreachable();
 }
 
+#if defined(B2L)
+extern void cpu_signal_handler(void);
+extern uint32_t b2l_irq_ack(void);
+extern void b2l_irq_eoi(uint32_t iar);
+extern void b2l_irq_record(unsigned intid);

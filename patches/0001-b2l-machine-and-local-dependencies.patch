-#if USE_APPLEARMSMP
+#if defined(B2L)
+	uint32_t iar = b2l_irq_ack();
+	unsigned intid = iar & 0x3ffU;
+	/* GICv2 reserves 1020..1023 as special/spurious acknowledgements. */
+	if (intid < 1020) {
+		b2l_irq_record(intid);
+		if (intid == B2L_TIMER_INTID) {

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 6aa6fe4..b3f76ae 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -33,7 +33,13 @@
 #include <pexpert/arm64/board_config.h>
 #include <mach_assert.h>
 #include <machine/asm.h>
+#if defined(ARM64_BOARD_CONFIG_B2L)
+/* Exynos does not implement Apple's SoC-specific implementation registers. */
+.macro APPLY_TUNABLES midr, tmp1, tmp2
+.endmacro
+#else
 #include <arm64/tunables/tunables.s>
+#endif
 #include <arm64/exception_asm.h>
 
 #if __ARM_KERNEL_PROTECT__
@@ -474,6 +480,33 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(B2L)
+	// Physical-entry proof before page tables or C runtime.  x9..x13 are
+	// scratch registers.  boot_args.Video starts at byte 40 in ABI v2.
+	// The loader validates a 32-bit GOP and dimensions before handoff.
+	ldr		x9, [x20, #40]
+	and		x9, x9, #~3
+	cbz		x9, Lb2l_entry_marker_done
+	ldr		x10, [x20, #56]
+	lsl		x11, x10, #7              // y=128
+	add		x9, x9, x11
+	add		x9, x9, #512              // x=128, 32bpp
+	mov		w11, #0xff00              // green 16x16 entry marker
+	mov		x12, #16
+Lb2l_entry_marker_row:
+	mov		x13, #16
+Lb2l_entry_marker_pixel:
+	str		w11, [x9], #4
+	subs	x13, x13, #1
+	b.ne	Lb2l_entry_marker_pixel
+	sub		x9, x9, #64
+	add		x9, x9, x10
+	subs	x12, x12, #1
+	b.ne	Lb2l_entry_marker_row
+	dsb		sy
+Lb2l_entry_marker_done:
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff

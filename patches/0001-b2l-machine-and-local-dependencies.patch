+
+static void
+b2l_gic_write(vm_offset_t base, unsigned offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+}
+
+uint32_t
+b2l_irq_ack(void)
+{
+	return b2l_gic_read(b2l_gicc, 0x00c); /* GICC_IAR, preserve SGI source bits */
+}
+
+void
+b2l_irq_eoi(uint32_t iar)
+{
+	b2l_gic_write(b2l_gicc, 0x010, iar);
+	__builtin_arm_dsb(DSB_SY);
+}
+
+void
+b2l_send_self_ipi(void)
+{
+	__builtin_arm_dsb(DSB_ISHST);
+	b2l_gic_write(b2l_gicd, 0xf00, (2U << 24) | 1U);
+	__builtin_arm_dsb(DSB_SY);
+}
+
+void
+b2l_irq_record(unsigned intid)
+{
+	if (intid == B2L_TIMER_INTID) {
+		b2l_timer_irqs++;
+	} else if (intid == 1) {
+		b2l_signal_irqs++;
+	}
+}
+
+uint64_t
+b2l_irq_count(boolean_t timer)
+{
+	return timer ? b2l_timer_irqs : b2l_signal_irqs;
+}
+
+void
+pe_init_fiq(void)
+{
+	if (b2l_gicd == 0) {
+		DTEntry entry;
+		const void *prop;
+		unsigned size;
+		if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess ||
+		    SecureDTGetProperty(entry, "reg", &prop, &size) != kSuccess ||
+		    size != 4 * sizeof(uint64_t)) {
+			panic("B2L GIC: missing GICv2 MMIO ranges");
+		}
+		const uint64_t *reg = prop;
+		uint64_t soc = pe_arm_get_soc_base_phys();
+		/* Refuse an unrelated firmware tree before touching controller MMIO. */
+		if (soc + reg[0] != B2L_GICD_PA || soc + reg[2] != B2L_GICC_PA ||
+		    reg[1] != 0x1000 || reg[3] != 0x1000) {
+			panic("B2L GIC: unexpected Exynos 9820 register ranges");
+		}
+		b2l_gicd = ml_io_map(soc + reg[0], reg[1]);
+		b2l_gicc = ml_io_map(soc + reg[2], reg[3]);
+		if (!b2l_gicd || !b2l_gicc) {
+			panic("B2L GIC: cannot map controller");
+		}
+		/* No peripheral drivers exist in the first-boot target.  Mask stale
+		 * non-secure firmware SPIs; secure interrupt bits are RAZ/WI here. */
+		unsigned banks = (b2l_gic_read(b2l_gicd, 0x004) & 31U) + 1;
+		for (unsigned bank = 1; bank < banks; ++bank) {
+			b2l_gic_write(b2l_gicd, 0x180 + bank * 4, UINT32_MAX);
+			b2l_gic_write(b2l_gicd, 0x280 + bank * 4, UINT32_MAX);
+		}
+	}
+	const uint32_t sources = (1U << B2L_TIMER_INTID) | (1U << 1);
+	b2l_gic_write(b2l_gicd, 0x180, UINT32_MAX); /* banked PPI/SGI masks */
+	b2l_gic_write(b2l_gicd, 0x080,
+	    b2l_gic_read(b2l_gicd, 0x080) | sources); /* Group 1 */
+	b2l_gic_write(b2l_gicd, 0x280, sources);
+	/* Banked priorities: SGI1 and virtual timer PPI27. */
+	*(volatile uint8_t *)(b2l_gicd + 0x401) = 0x80;
+	*(volatile uint8_t *)(b2l_gicd + 0x400 + B2L_TIMER_INTID) = 0xa0;
+	b2l_gic_write(b2l_gicd, 0x100, sources);
+	b2l_gic_write(b2l_gicc, 0x004, 0xff); /* priority mask */
+	b2l_gic_write(b2l_gicc, 0x008, 0);    /* no priority grouping */
+	/* Non-secure bit0 is EnableGrp1; bit9 selects split EOI/deactivate.
+	 * Use combined EOI so GICC_EOIR deactivates as well as drops priority. */
+	b2l_gic_write(b2l_gicc, 0x000,
+	    (b2l_gic_read(b2l_gicc, 0x000) & ~(1U << 9)) | 1U);
+	b2l_gic_write(b2l_gicd, 0x000,
+	    b2l_gic_read(b2l_gicd, 0x000) | 1U);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+	kprintf("B2L GIC: GICv2 IRQ ready, timer=%u, SGI=1, CNTFRQ=%llu Hz\n",
+	    B2L_TIMER_INTID, __builtin_arm_rsr64("CNTFRQ_EL0"));
+}
+#elif HAS_GIC_V3
 #define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
 MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
 

@@ -1807,6 +1809,43 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_SLIDE_RANGE (1ULL << 30) // 1 GB
 #define ARM64_PHYSMAP_SLIDE_MASK  (ARM64_PHYSMAP_SLIDE_RANGE - 1)
 
+#if defined(B2L)
+/* This virtual window is already excluded from the VM allocator by
+ * pmap_virtual_region(3): VM_MIN_KERNEL_ADDRESS .. LOW_GLOBAL_BASE_ADDRESS.
+ * It maps only the existing firmware GOP. No physical RAM guard is changed. */
+#define B2L_EARLY_FB_VA (LOW_GLOBAL_BASE_ADDRESS - (32ULL * 1024 * 1024))
+static vm_offset_t
+b2l_map_early_framebuffer(void)
+{
+	uint64_t physical, length;
+	if (!b2l_early_range(&physical, &length)) return 0;
+	uint64_t page_base = physical & ~ARM_TT_L2_OFFMASK;
+	uint64_t offset = physical - page_base;
+	uint64_t span = (offset + length + ARM_TT_L2_OFFMASK) & ~ARM_TT_L2_OFFMASK;

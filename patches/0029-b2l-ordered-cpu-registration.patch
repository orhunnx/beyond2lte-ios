--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1650,6 +1650,10 @@
     processor_t *processor_out, ipi_handler_t *ipi_handler_out,
     perfmon_interrupt_handler_func *pmi_handler_out)
 {
+#if defined(B2L)

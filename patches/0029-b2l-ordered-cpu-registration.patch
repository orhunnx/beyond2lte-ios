@@ -1751,7 +1761,13 @@
 #endif
 
 	if (!is_boot_cpu) {
+#if defined(B2L)
+        b2l_early_trace("B2L REG: cpu=%u random begin\n", in_processor_info->log_id);
+#endif
 		random_cpu_init(this_cpu_datap->cpu_number);
+#if defined(B2L)
+        b2l_early_trace("B2L REG: cpu=%u random done\n", in_processor_info->log_id);

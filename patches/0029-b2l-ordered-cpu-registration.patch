--- a/osfmk/kern/processor.c
+++ b/osfmk/kern/processor.c
@@ -1304,8 +1304,15 @@
 processor_boot(
 	processor_t                     processor)
 {
+#if defined(B2L)
+    extern void b2l_early_trace(const char *, ...);
+    b2l_early_trace("B2L BOOT: cpu=%d lock begin\n", processor->cpu_id);
+#endif
 	lck_mtx_lock(&cluster_powerdown_lock);
 	lck_mtx_lock(&processor_updown_lock);
+#if defined(B2L)
+    b2l_early_trace("B2L BOOT: cpu=%d locks held\n", processor->cpu_id);
+#endif
 
 	assert(!sched_is_in_sleep());
 	assert(!sched_is_cpu_init_completed());
@@ -1324,11 +1331,23 @@
 	 *	Create the idle processor thread.
 	 */
 	if (processor->idle_thread == THREAD_NULL) {
+#if defined(B2L)
+        b2l_early_trace("B2L BOOT: cpu=%d idle thread begin\n", processor->cpu_id);
+#endif
 		idle_thread_create(processor, processor_start_thread);
+#if defined(B2L)
+        b2l_early_trace("B2L BOOT: cpu=%d idle thread done\n", processor->cpu_id);
+#endif
 	}
 
 	if (processor->processor_self == IP_NULL) {
+#if defined(B2L)
+        b2l_early_trace("B2L BOOT: cpu=%d IPC begin\n", processor->cpu_id);
+#endif
 		ipc_processor_init(processor);
+#if defined(B2L)
+        b2l_early_trace("B2L BOOT: cpu=%d IPC done\n", processor->cpu_id);
+#endif
 	}
 
 	if (processor == master_processor) {
@@ -1336,9 +1355,15 @@
 
 		ml_cpu_power_enable(processor->cpu_id);
 
+#if defined(B2L)
+        b2l_early_trace("B2L BOOT: cpu=%d bind begin\n", processor->cpu_id);
+#endif
 		processor_t prev = thread_bind(processor);
 		thread_block(THREAD_CONTINUE_NULL);
 
+#if defined(B2L)
+        b2l_early_trace("B2L BOOT: cpu=%d cpu_start begin\n", processor->cpu_id);
+#endif
 		cpu_start(processor->cpu_id);
 
 		assert(processor->state == PROCESSOR_RUNNING);
